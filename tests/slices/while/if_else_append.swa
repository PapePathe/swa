dialect:english;

func is_even(n: int) bool {
  return n/2*2 == n;
}

start() int {
  let s: []int = make([]int);
  let i: int = 0;
  while (i < 5) {
    if (is_even(i)) {
      s << i;
    } else {
      s << i * 10;
    }
    i = i + 1;
  }
  let c: int = 0;
  while (c < count(s)) {
    print(s[c]);
    c = c + 1;
  }
  return 0;
}
