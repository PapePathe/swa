dialect:english;

struct Inner {
  vals: []int,
}

struct Outer {
  inners: []Inner,
}

start() int {
  let out: Outer = Outer{inners: make([]Inner)};
  
  let in1: Inner = Inner{vals: make([]int)};
  in1.vals << 10;
  out.inners << in1;
  
  // deeply nested appended directly mapped over multiple pointers!
  out.inners[0].vals << 20;

  print(count(out.inners));
  print(count(out.inners[0].vals));
  print(out.inners[0].vals[0]);
  print(out.inners[0].vals[1]);

  return 0;
}
