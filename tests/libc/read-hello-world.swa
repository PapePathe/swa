dialect:english;

start() int {
  let fd : int = open("./libc/hello.txt", 0);

  let buf : [1024]byte;
  let size : int64 = 2048;
  let counter : int64 = read(fd, buf, size);

  let i : int;
  while(i < counter) {
    print("%c", buf[i]);
    i = i + 1;
  }

  let res :int =close(fd);

  return 0;
}
